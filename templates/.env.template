# Environment variables for Docker container and docker-compose.yml
# Used by run.sh for model validation and server configuration

# Model configuration
MODEL_NAME=Qwen3.6-35B-A3B-UD-Q4_K_XL
MODEL_NAME_ALIAS=qwen3.6-35b
HF_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
# Host directory with GGUF files, mounted at /models (default ./models).
# Tip: mount the parent dir and put the subdirectory in MODEL_NAME, so switching models
# is one line, e.g. MODELS_DIR=/home/me/models/gguf + MODEL_NAME=gpt-oss-20b-mxfp4/gpt-oss-20b-MXFP4
# Non-Qwen models: also set CHAT_TEMPLATE= (empty) to use the template stored in the GGUF.
MODELS_DIR=./models
CTX_SIZE=98304
FLASH_ATTN=on
THREADS=5
BATCH_SIZE=256
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
NO_MMAP=false
PARALLEL=1
CACHE_RAM=4096

# Fit / speculative decoding
FIT=on
FIT_TARGET=256
FIT_CTX=98304
UBATCH_SIZE=256
POLL_BATCH=0

# Sampling
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# Penalties
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# Features
REASONING=on

# Jinja chat template (leave empty to use model's built-in template)
CHAT_TEMPLATE=/app/qwen_chat_template.jinja

# Server configuration
HOST=0.0.0.0
PORT_INTERNAL=8080
PORT_EXTERNAL=8001
# Host address the model API is published on. 127.0.0.1 = this machine only (default).
# The server has no API key by default: before setting 0.0.0.0 or a Tailscale IP,
# also set LLAMA_API_KEY (llama-server reads it natively) and pass the same key to your client.
BIND_ADDRESS=127.0.0.1

# Hardware: force CPU even if a GPU is available (on/off)
FORCE_CPU=off

# GPU backend: auto | nvidia | rocm | vulkan | sglang | vllm
# auto = NVIDIA if nvidia runtime found, else ROCm if /dev/kfd exists, else CPU
GPU_BACKEND=auto
# AMD only: render nodes passed to the container. List ONLY discrete GPUs —
# an iGPU on the same host would otherwise join the split.
# Find yours: cat /sys/class/drm/renderD*/device/uevent | grep PCI_ID
AMD_GPU0=/dev/dri/renderD128
AMD_GPU1=/dev/dri/renderD129

# SGLang backend only (GPU_BACKEND=sglang): BF16 safetensors, not GGUF.
# MODEL_NAME becomes the served model id (opencode.json uses it).
SGLANG_IMAGE=sglang-rdna4:v0.5.18
SGLANG_MODELS_DIR=./models          # host dir with HF model folders
SGLANG_MODEL=                       # folder name under SGLANG_MODELS_DIR
SGLANG_TP=1                         # 2 = split across both cards
SGLANG_CTX=32768
SGLANG_MEM_FRACTION=0.85
SGLANG_TOOL_PARSER=                 # e.g. hermes (Bielik v3.1), qwen25, mistral, llama3; empty = no tool calls

# vLLM backend only (GPU_BACKEND=vllm): `vllm serve` from a host venv (scripts/vllm-host.sh).
VLLM_BIN=                           # default ~/venvs/vllm/bin/vllm
VLLM_MODELS_DIR=./models
VLLM_MODEL=                         # folder under VLLM_MODELS_DIR (BF16 or AWQ)
VLLM_TP=1
VLLM_CTX=32768
VLLM_GPU_UTIL=0.85
VLLM_TOOL_PARSER=                   # e.g. hermes (Bielik v3.1), mistral, llama3_json
VLLM_VISIBLE_DEVICES=0,1            # ROCR_VISIBLE_DEVICES: discrete GPUs only, no iGPU

# GPU offload (llama.cpp)
# Device order here: CUDA0 = RTX 2070S (8 GB), CUDA1 = GTX 1080 Ti (11 GB)
GPU_LAYERS=all          # 'all', 'auto', or a layer count
SPLIT_MODE=layer        # split model layers across both GPUs
TENSOR_SPLIT=40,60      # ~VRAM ratio (2070S:1080Ti); 2x equal cards (e.g. 2x R9700) -> 50,50
# Leave MAIN_GPU empty to use the default (GPU 0)
MAIN_GPU=

# SearXNG secret (auto-generated on first run if empty)
SEARXNG_SECRET=